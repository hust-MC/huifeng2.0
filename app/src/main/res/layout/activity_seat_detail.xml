<?xml version="1.0" encoding="utf-8"?>
<!--
  座位体感详情页 (1-1 详情页) — 框架版
  - 中央：3D 人像
  - 左侧浮动：4 座位切换 2x2 网格
  - 底部：DOCK 栏占位（业务系统保留）
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_body_feel">

    <!-- ============ 顶部标题栏（复用 BodyFeelActivity 的 title_bodyfeel 图） ============ -->
    <ImageView
        android:layout_width="615px"
        android:layout_height="64px"
        android:layout_marginStart="80px"
        android:layout_marginTop="124px"
        android:src="@drawable/title_bodyfeel" />

    <!-- ============ 中央主区：3D 人像 ============ -->
    <FrameLayout
        android:id="@+id/fl_figure_area"
        android:layout_width="796px"
        android:layout_height="1384px"
        android:layout_marginStart="388px"
        android:layout_marginTop="179px">

        <ImageView
            android:id="@+id/iv_seat_detail_figure"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/body_detail" />
    </FrameLayout>

    <!-- ============ 左侧 4 座位浮动面板（背景图 + 2x2 网格） ============ -->
    <FrameLayout
        android:layout_width="245px"
        android:layout_height="524px"
        android:layout_marginStart="84px"
        android:layout_marginTop="231px">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_seat_switch" />

        <GridLayout
            android:id="@+id/gl_seat_thumbs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:columnCount="2"
            android:rowCount="2"
            android:useDefaultMargins="false" />
    </FrameLayout>

    <!-- ============ 右侧详情卡（300x778 / 弧度 25 / 边框 1.56） ============ -->
    <LinearLayout
        android:id="@+id/ll_seat_detail_card"
        android:layout_width="300px"
        android:layout_height="778px"
        android:layout_marginStart="1264px"
        android:layout_marginTop="179px"
        android:background="@drawable/bg_seat_detail_card"
        android:orientation="vertical"
        android:paddingStart="24px"
        android:paddingTop="32px"
        android:paddingEnd="24px"
        android:paddingBottom="24px">

        <!-- 上：档位大圆 + 圆内 "凉" 字 -->
        <com.max.huifeng.ComfortIconView
            android:id="@+id/iv_seat_detail_icon"
            android:layout_width="240px"
            android:layout_height="240px"
            android:layout_gravity="center_horizontal" />

        <!-- 圆圈下方说明文字："主驾驶舒适感" -->
        <TextView
            android:id="@+id/tv_seat_detail_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18.72px"
            android:text="主驾驶舒适感"
            android:textColor="#62748E"
            android:textSize="18.72px" />

        <!-- 英文档位 pill -->
        <TextView
            android:id="@+id/tv_seat_detail_label_en"
            android:layout_width="wrap_content"
            android:layout_height="40px"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10px"
            android:background="@drawable/bg_seat_detail_pill"
            android:gravity="center"
            android:paddingStart="24px"
            android:paddingEnd="24px"
            android:text="COLD"
            android:textColor="#3C86ED"
            android:textSize="20px"
            android:textStyle="bold" />

        <!-- 中间弹性留白，把分割线顶到下方 -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:background="#1F000000" />

        <!-- 下：温 / 湿 / PMV / PPD 四宫格 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24px"
            android:orientation="vertical">

            <!-- 温度 | 湿度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="温度"
                        android:textColor="#7A8492"
                        android:textSize="18px" />

                    <TextView
                        android:id="@+id/tv_seat_detail_temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6px"
                        android:text="25.5°C"
                        android:textColor="#1F2A36"
                        android:textSize="26px"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="湿度"
                        android:textColor="#7A8492"
                        android:textSize="18px" />

                    <TextView
                        android:id="@+id/tv_seat_detail_humidity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6px"
                        android:text="44%"
                        android:textColor="#1F2A36"
                        android:textSize="26px"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- PMV | PPD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18px"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PMV"
                        android:textColor="#7A8492"
                        android:textSize="18px" />

                    <TextView
                        android:id="@+id/tv_seat_detail_pmv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6px"
                        android:text="-0.8"
                        android:textColor="#1F2A36"
                        android:textSize="26px"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PPD"
                        android:textColor="#7A8492"
                        android:textSize="18px" />

                    <TextView
                        android:id="@+id/tv_seat_detail_ppd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6px"
                        android:text="18%"
                        android:textColor="#1F2A36"
                        android:textSize="26px"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 身体部位体感状态外框：1194x387 弧度24.96 边框1.56 #000000 6% 底色#D6DDE6 -->
    <LinearLayout
        android:layout_width="1194px"
        android:layout_height="387px"
        android:layout_marginStart="1258px"
        android:layout_marginTop="1004px"
        android:background="@drawable/bg_body_part_card"
        android:orientation="vertical"
        android:padding="24.96px">

        <!-- 标题 + 图例：同一纵坐标 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="身体部位当前体感状态"
                android:textColor="#45556C"
                android:textSize="18.72px" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 图例：暖/稍暖/合适/稍凉/凉 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="25px"
                android:orientation="horizontal">

                <View
                    android:layout_width="14px"
                    android:layout_height="14px"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_legend_dot_warm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8.36px"
                    android:text="暖"
                    android:textColor="#000000"
                    android:textSize="16.73px" />

                <View
                    android:layout_width="14px"
                    android:layout_height="14px"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="22.3px"
                    android:background="@drawable/bg_legend_dot_slightly_warm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8.36px"
                    android:text="稍暖"
                    android:textColor="#000000"
                    android:textSize="16.73px" />

                <View
                    android:layout_width="14px"
                    android:layout_height="14px"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="22.3px"
                    android:background="@drawable/bg_legend_dot_just_right" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8.36px"
                    android:text="合适"
                    android:textColor="#000000"
                    android:textSize="16.73px" />

                <View
                    android:layout_width="14px"
                    android:layout_height="14px"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="22.3px"
                    android:background="@drawable/bg_legend_dot_slightly_cool" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8.36px"
                    android:text="稍凉"
                    android:textColor="#000000"
                    android:textSize="16.73px" />

                <View
                    android:layout_width="14px"
                    android:layout_height="14px"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="22.3px"
                    android:background="@drawable/bg_legend_dot_cool" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8.36px"
                    android:text="凉"
                    android:textColor="#000000"
                    android:textSize="16.73px" />
            </LinearLayout>
        </LinearLayout>

        <!-- 内容占位，后续填充BodyPartOverlayView -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 12 部位卡片：2行×6列 -->
        <!-- 外框 padding=24.96，内容区余高=337.08px，row1顶=55.96，gapY=16.16 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="55.96px"
            android:orientation="vertical">

            <!-- 第1行：头部 脸部 颈部 肩部 前胸 后背 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/card_head"
                    android:layout_width="181px"
                    android:layout_height="120px"
                    android:background="@drawable/bg_body_part_cell">

                    <ImageView
                        android:id="@+id/card_head_icon"
                        android:layout_width="26.88px"
                        android:layout_height="26.88px"
                        android:layout_marginStart="12.48px"
                        android:layout_marginTop="17.44px"
                        android:src="@drawable/body_feel_detail_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="14px"
                        android:layout_marginBottom="20px"
                        android:text="头部"
                        android:textColor="#314158"
                        android:textSize="18px" />
                </FrameLayout>

                <View
                    android:layout_width="3.7px"
                    android:layout_height="0dp" />

                <FrameLayout
                    android:id="@+id/card_face"
                    android:layout_width="181px"
                    android:layout_height="120px"
                    android:background="@drawable/bg_body_part_cell">

                    <ImageView
                        android:id="@+id/card_face_icon"
                        android:layout_width="26.88px"
                        android:layout_height="26.88px"
                        android:layout_marginStart="12.48px"
                        android:layout_marginTop="17.44px"
                        android:src="@drawable/body_feel_detail_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="14px"
                        android:layout_marginBottom="20px"
                        android:text="脸部"
                        android:textColor="#314158"
                        android:textSize="18px" />
                </FrameLayout>

                <View
                    android:layout_width="3.7px"
                    android:layout_height="0dp" />

                <FrameLayout
                    android:id="@+id/card_neck"
                    android:layout_width="181px"
                    android:layout_height="120px"
                    android:background="@drawable/bg_body_part_cell">
                    <ImageView
                        android:id="@+id/card_neck_icon"
                        android:layout_width="26.88px"
                        android:layout_height="26.88px"
                        android:layout_marginStart="12.48px"
                        android:layout_marginTop="17.44px"
                        android:src="@drawable/body_feel_detail_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="12.48px"
                        android:layout_marginBottom="19.44px"
                        android:text="颈部"
                        android:textColor="#314158"
                        android:textSize="18px" />
                </FrameLayout>

                <View
                    android:layout_width="3.7px"
                    android:layout_height="0dp" />

                <FrameLayout
                    android:id="@+id/card_shoulder"
                    android:layout_width="181px"
                    android:layout_height="120px"
                    android:background="@drawable/bg_body_part_cell">
                    <ImageView
                        android:id="@+id/card_shoulder_icon"
                        android:layout_width="26.88px"
                        android:layout_height="26.88px"
                        android:layout_marginStart="12.48px"
                        android:layout_marginTop="17.44px"
                        android:src="@drawable/body_feel_detail_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="12.48px"
                        android:layout_marginBottom="14.62px"
                        android:text="肩部"
                        android:textColor="#314158"
                        android:textSize="18px" />
                </FrameLayout>

                <View
                    android:layout_width="3.7px"
                    android:layout_height="0dp" />

                <FrameLayout
                    android:id="@+id/card_chest"
                    android:layout_width="181px"
                    android:layout_height="120px"
                    android:background="@drawable/bg_body_part_cell">
                    <ImageView
                        android:id="@+id/card_chest_icon"
                        android:layout_width="26.88px"
                        android:layout_height="26.88px"
                        android:layout_marginStart="12.48px"
                        android:layout_marginTop="17.44px"
                        android:src="@drawable/body_feel_detail_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="12.48px"
                        android:layout_marginBottom="14.62px"
                        android:text="前胸"
                        android:textColor="#314158"
                        android:textSize="18px" />
                </FrameLayout>

                <View
                    android:layout_width="3.7px"
                    android:layout_height="0dp" />

                <FrameLayout
                    android:id="@+id/card_back"
                    android:layout_width="181px"
                    android:layout_height="120px"
                    android:background="@drawable/bg_body_part_cell">

                    <ImageView
                        android:id="@+id/card_back_icon"
                        android:layout_width="26.88px"
                        android:layout_height="26.88px"
                        android:layout_marginStart="12.48px"
                        android:layout_marginTop="17.44px"
                        android:src="@drawable/body_feel_detail_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="12.48px"
                        android:layout_marginBottom="14.62px"
                        android:text="后背"
                        android:textColor="#314158"
                        android:textSize="18px" />
                </FrameLayout>
            </LinearLayout>

            <!-- 第2行：下腹 手臂 双手 大腿 小腿 脚部 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.16px"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/card_abdomen"
                    android:layout_width="181px"
                    android:layout_height="120px"
                    android:background="@drawable/bg_body_part_cell">

                    <ImageView
                        android:id="@+id/card_abdomen_icon"
                        android:layout_width="26.88px"
                        android:layout_height="26.88px"
                        android:layout_marginStart="12.48px"
                        android:layout_marginTop="17.44px"
                        android:src="@drawable/body_feel_detail_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="12.48px"
                        android:layout_marginBottom="14.62px"
                        android:text="下腹"
                        android:textColor="#314158"
                        android:textSize="18px" />
                </FrameLayout>

                <View
                    android:layout_width="3.7px"
                    android:layout_height="0dp" />

                <FrameLayout
                    android:id="@+id/card_arm"
                    android:layout_width="181px"
                    android:layout_height="120px"
                    android:background="@drawable/bg_body_part_cell">

                    <ImageView
                        android:id="@+id/card_arm_icon"
                        android:layout_width="26.88px"
                        android:layout_height="26.88px"
                        android:layout_marginStart="12.48px"
                        android:layout_marginTop="17.44px"
                        android:src="@drawable/body_feel_detail_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="12.48px"
                        android:layout_marginBottom="14.62px"
                        android:text="手臂"
                        android:textColor="#314158"
                        android:textSize="18px" />
                </FrameLayout>

                <View
                    android:layout_width="3.7px"
                    android:layout_height="0dp" />

                <FrameLayout
                    android:id="@+id/card_hand"
                    android:layout_width="181px"
                    android:layout_height="120px"
                    android:background="@drawable/bg_body_part_cell">

                    <ImageView
                        android:id="@+id/card_hand_icon"
                        android:layout_width="26.88px"
                        android:layout_height="26.88px"
                        android:layout_marginStart="12.48px"
                        android:layout_marginTop="17.44px"
                        android:src="@drawable/body_feel_detail_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="12.48px"
                        android:layout_marginBottom="14.62px"
                        android:text="双手"
                        android:textColor="#314158"
                        android:textSize="18px" />
                </FrameLayout>

                <View
                    android:layout_width="3.7px"
                    android:layout_height="0dp" />

                <FrameLayout
                    android:id="@+id/card_thigh"
                    android:layout_width="181px"
                    android:layout_height="120px"
                    android:background="@drawable/bg_body_part_cell">

                    <ImageView
                        android:id="@+id/card_thigh_icon"
                        android:layout_width="26.88px"
                        android:layout_height="26.88px"
                        android:layout_marginStart="12.48px"
                        android:layout_marginTop="17.44px"
                        android:src="@drawable/body_feel_detail_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="12.48px"
                        android:layout_marginBottom="14.62px"
                        android:text="大腿"
                        android:textColor="#314158"
                        android:textSize="18px" />
                </FrameLayout>

                <View
                    android:layout_width="3.7px"
                    android:layout_height="0dp" />

                <FrameLayout
                    android:id="@+id/card_calf"
                    android:layout_width="181px"
                    android:layout_height="120px"
                    android:background="@drawable/bg_body_part_cell">

                    <ImageView
                        android:id="@+id/card_calf_icon"
                        android:layout_width="26.88px"
                        android:layout_height="26.88px"
                        android:layout_marginStart="12.48px"
                        android:layout_marginTop="17.44px"
                        android:src="@drawable/body_feel_detail_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="12.48px"
                        android:layout_marginBottom="14.62px"
                        android:text="小腿"
                        android:textColor="#314158"
                        android:textSize="18px" />
                </FrameLayout>

                <View
                    android:layout_width="3.7px"
                    android:layout_height="0dp" />

                <FrameLayout
                    android:id="@+id/card_foot"
                    android:layout_width="181px"
                    android:layout_height="120px"
                    android:background="@drawable/bg_body_part_cell">

                    <ImageView
                        android:id="@+id/card_foot_icon"
                        android:layout_width="26.88px"
                        android:layout_height="26.88px"
                        android:layout_marginStart="12.48px"
                        android:layout_marginTop="17.44px"
                        android:src="@drawable/body_feel_detail_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="12.48px"
                        android:layout_marginBottom="14.62px"
                        android:text="脚部"
                        android:textColor="#314158"
                        android:textSize="18px" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 内容占位，后续填充BodyPartOverlayView -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="147px"
        android:layout_gravity="bottom"
        android:background="#33FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="147px"
        android:layout_gravity="center_horizontal|bottom"
        android:gravity="center"
        android:text="DOCK栏"
        android:textColor="#888080"
        android:textSize="32px" />

</FrameLayout>